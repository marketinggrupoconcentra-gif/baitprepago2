# ==========================================
# BAIT PREPAGO 2 - ENV VARIABLES TEMPLATE
# ==========================================
# Instrucciones:
# Copiar este archivo a `.env.local` o `.env.branch` y poblar
# las variables con los valores correspondientes al entorno.
# NO almacenar API keys reales ni contraseñas en este archivo.

# --- BASE DE DATOS (Neon PostgreSQL) ---
DATABASE_URL=""
DUPLICATES_DATABASE_URL=""
POSTGRES_URL=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_USER=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE=""

# --- INTEGRACIÓN NEON / AISLAMIENTO ---
VERCEL_ENV="development" # development, preview, production
EXPECTED_NEON_BRANCH_ID=""
EXPECTED_NEON_ENDPOINT_ID=""
EXPECTED_DUPLICATES_NEON_ENDPOINT_ID=""
EXPECTED_DUPLICATES_DATABASE_NAME=""

# --- SEGURIDAD Y HASHING ---
CAPTCHA_PEPPER="" # Clave HMAC para hashing de captchas

# --- INTEGRACIÓN DE CORREO (Resend) ---
RESEND_API_KEY=""
PRODUCTION_EMAIL_ENABLED="false"
SUPPORT_EMAIL="soporte@tu-dominio.com"

# --- URLs Y RUTAS ---
APP_BASE_URL="http://localhost:3000"
