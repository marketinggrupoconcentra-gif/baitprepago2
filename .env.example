# ─────────────────────────────────────────────────────────────────────────────
#  BAIT PREPAGO (baitprepago2) — Contrato de Variables de Entorno (motor Scale)
#
#  NUNCA pongas valores reales en este archivo. Copia a .env.local y completa.
#
#  Clasificación:
#    [REQUIRED]  — El servidor lanza (throw) en producción si no está configurada
#    [OPTIONAL]  — Integración opcional; la app degrada graciosamente si falta
#    [DEFAULT]   — Tiene valor por defecto en el código; puede sobrescribirse
#    [PUBLIC]    — Seguro exponer en cliente (NEXT_PUBLIC_*)
#    [LOCAL]     — Solo para desarrollo local / tests (NUNCA en Vercel)
# ─────────────────────────────────────────────────────────────────────────────

# ── BASE DE DATOS (Neon proyecto sweet-mud-87845510 / base neondb / schema app) ──
# [REQUIRED] Rol owner/migración (solo drizzle-kit migrate y scripts/*). NUNCA en el runtime de Vercel.
DATABASE_URL=

# [REQUIRED] Rol de runtime de mínimo privilegio (baitprepago_app_runtime). Lo imprime
#   node --env-file=.env.local scripts/provision-runtime-role.mjs
APP_DATABASE_URL=

# ── CIFRADO PII (Application-Layer Encryption) ────────────────────────────────
# [REQUIRED] AES-256-GCM para cifrar PII (nombre, apellido, email, teléfono)
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=

# [REQUIRED] HMAC-SHA256 para blind indexes (búsqueda exacta sin descifrar). DISTINTA a la anterior.
PII_BLIND_INDEX_KEY=

# [REQUIRED] HMAC-SHA256 para hash de IP (security_events / audit_logs). DISTINTA a las anteriores.
IP_HASH_KEY=

# ── CAPTCHA PROPIO DE LA LANDING (POST /api/captcha/challenge) ────────────────
# [REQUIRED] Pepper HMAC del reto CAPTCHA. Sin él, emisión y validación fallan cerrado.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_PEPPER=

# ── CRON JOBS ─────────────────────────────────────────────────────────────────
# [REQUIRED] Secret para autenticar Vercel Cron → API (Authorization: Bearer <secret>)
CRON_SECRET=

# ── APLICACIÓN ────────────────────────────────────────────────────────────────
# [DEFAULT] URL canónica de producción (metadataBase, validación de Origin, emails).
APP_URL=https://baitprepago.com

# [DEFAULT] Orígenes adicionales permitidos (separados por coma): www + alias de Vercel.
ALLOWED_ORIGINS=https://baitprepago.com,https://www.baitprepago.com,https://baitprepago2.vercel.app

# ── REGLAS DE NEGOCIO ─────────────────────────────────────────────────────────
# [DEFAULT] Código de plan que se guarda en app.leads.plan_code
LEAD_PLAN_CODE=prepago_100
# [DEFAULT] Ventana de deduplicación técnica (idempotency_keys), horas
LEAD_DEDUPE_WINDOW_HOURS=24
# [DEFAULT] Retención de lead_secrets (vacía en prepago: el NIP no se persiste), horas
NIP_RETENTION_HOURS=72
# [DEFAULT] Tiempo mínimo de llenado de formulario (ms) — protección anti-bot
SECURITY_MIN_FORM_FILL_MS=4000
# [DEFAULT] Email de confirmación al lead tras registrar la solicitud: off | on (requiere Resend)
LEAD_CONFIRMATION_EMAIL=off

# ── ANTI-ABUSO / EDGE (src/proxy.ts → src/lib/security/edge-guard.ts) ─────────
# Rate limiter EN MEMORIA del edge (por IP, ventana 60s). Vacío → valor por defecto.
# [DEFAULT] Clientes sospechosos (curl, scrapy, headers de bot). Default: 12
EDGE_RL_STRICT=
# [DEFAULT] Tráfico /api/* normal por IP. Default: 80
EDGE_RL_API=
# [DEFAULT] Navegación de páginas por IP. Default: 240
EDGE_RL_PAGE=

# ── VERSIONES DE POLÍTICA ─────────────────────────────────────────────────────
# [DEFAULT] Versión del Aviso de Privacidad (se almacena inmutablemente en lead_consents)
PRIVACY_POLICY_VERSION=1.0.0
# [DEFAULT] Versión de términos
TERMS_VERSION=1.0.0

# ── TRACKING PÚBLICO (cliente) ────────────────────────────────────────────────
# [PUBLIC][OPTIONAL] GTM — la landing (bait-analytics.js) y el admin lo leen vía GET /api/analytics/config
NEXT_PUBLIC_GTM_ID=
# [PUBLIC][OPTIONAL] GA4 — solo si NO hay GTM
NEXT_PUBLIC_GA4_ID=
# [PUBLIC][OPTIONAL] Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=
# [DEFAULT][PUBLIC] Nombre del query param de cada click id
NEXT_PUBLIC_GCLID_PARAM=gclid
NEXT_PUBLIC_FBCLID_PARAM=fbclid
NEXT_PUBLIC_TTCLID_PARAM=ttclid

# ── META (Server-Side Conversions API) — sin uso en el motor actual ───────────
# [OPTIONAL]
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# ── RESEND (Email: reportes programados y, opcionalmente, confirmación al lead) ──
# [OPTIONAL] API Key de Resend (también editable en app.settings → resend_api_key)
RESEND_API_KEY=
# [OPTIONAL] Remitente verificado en Resend (dominio baitprepago.com)
RESEND_FROM_EMAIL=
# [DEFAULT] Nombre del remitente
RESEND_FROM_NAME=BAIT Prepago

# ── NEON AUTH (Autenticación Admin — servidor administrado) ───────────────────
# [REQUIRED] Base URL del servidor Neon Auth de este branch (no es secreto): neon neon-auth status / MCP get_auth
NEON_AUTH_BASE_URL=
# [REQUIRED] Secreto para firmar la cookie de sesión (>= 32 chars). No rotar sin invalidar sesiones.
#   Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=
# [REQUIRED] Email del primer Administrador (POST /api/admin/bootstrap o scripts/create-admin-direct.mjs)
ADMIN_BOOTSTRAP_EMAIL=
# [LOCAL] Solo para scripts/create-admin-direct.mjs (bootstrap sin email). NUNCA en Vercel. Rotar tras el primer login.
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Administrador

# ── GOOGLE ADS (SEM · extracción automática de métricas → app.ads_metrics) ────
# [OPTIONAL] Cron /api/cron/google-ads. Sin credenciales el admin muestra "no conectado".
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CREDENTIALS_B64=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_ACCOUNT_ID=
GOOGLE_ADS_CAMPAIGN_FILTER=
# [OPTIONAL] Secreto del webhook POST /api/webhooks/google-ads (stub: solo registra en log)
GOOGLE_ADS_WEBHOOK_SECRET=
# [LOCAL] scripts/get-refresh-token.mjs — OAuth client de Google Ads (nunca hardcodear)
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=

# ── ATRIBUCIÓN ────────────────────────────────────────────────────────────────
# [DEFAULT] HMAC para hashear gclid/fbclid en lead_attribution. Si falta, usa PII_BLIND_INDEX_KEY.
CLICK_ID_SECRET=

# ── TESTS / LOCAL (NUNCA en Vercel) ───────────────────────────────────────────
# [LOCAL] Rama Neon EFÍMERA para tests de integración. Host distinto al de DATABASE_URL
#   (tests/integration/etapa22.test.ts falla cerrado si apunta a producción).
TEST_DATABASE_URL=
# [LOCAL] Rol owner de esa misma rama (verifica grants del rol runtime)
TEST_OWNER_DATABASE_URL=
# [LOCAL] URL del rol runtime en la rama de test (tests/integration/etapa22.test.ts)
APP_RUNTIME_DATABASE_URL=
# [LOCAL] IDs de rama Neon que valida etapa22.test.ts (test ≠ producción)
TEST_NEON_BRANCH_ID=
PROD_NEON_BRANCH_ID=br-lingering-sun-avyoux4u
PROD_NEON_ENDPOINT_PREFIX=ep-square-recipe
# [LOCAL] scripts/provision-runtime-role.mjs — nombre/contraseña del rol runtime (password se genera si va vacío)
RUNTIME_ROLE_NAME=baitprepago_app_runtime
RUNTIME_ROLE_PASSWORD=
RUNTIME_DB_NAME=
# [LOCAL] Playwright E2E (tests/e2e)
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_READER_EMAIL=
E2E_READER_PASSWORD=
